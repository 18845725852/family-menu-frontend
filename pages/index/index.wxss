@import "./compact.wxss";
@import "./preview.wxss";
page { min-height: 100vh; }
.page-shell { position: relative; z-index: 1; min-height: 100vh; padding-bottom: 150rpx; }
.hero { display:flex; justify-content:space-between; align-items:flex-end; padding: 44rpx 40rpx 32rpx; background:transparent; }
.eyebrow { display:block; color:#8a988f; font-size:20rpx; letter-spacing:3rpx; font-weight:600; }
.hero-title { margin-top:14rpx; font-size:44rpx; line-height:1.25; font-weight:700; letter-spacing:0; }
.hero-subtitle { margin-top:12rpx; color:#7b8981; font-size:24rpx; }
.hero-mark { color:#d6a455; font-size:84rpx; line-height:1; transform:rotate(-15deg); }
.tabs { display:flex; padding:0 40rpx; border-bottom:1rpx solid #e4e9e4; background:#f6f7f2; }
.tab { position:relative; padding:20rpx 8rpx 24rpx; margin-right:48rpx; color:#89958d; font-size:28rpx; }
.tab-active { color:#20302a; font-weight:700; }
.tab-active:after { content:''; position:absolute; left:0; right:0; bottom:-1rpx; height:6rpx; background:#d6a455; border-radius:6rpx 6rpx 0 0; }
.tab-count { margin-left:8rpx; padding:3rpx 10rpx; color:#fff; background:#d6a455; border-radius:20rpx; font-size:20rpx; }
.tab-count.muted { color:#7d8a82; background:#e7ebe7; }
.content { height:calc(100vh - 270rpx); width:calc(100% - 80rpx); margin-left:40rpx; margin-right:40rpx; padding:0; box-sizing:border-box; }
.category-list { white-space:nowrap; padding:30rpx 0 24rpx; }
.category { display:inline-block; margin-right:18rpx; padding:12rpx 24rpx; border:1rpx solid #dfe6df; border-radius:28rpx; color:#7e8b83; background:#fafbf9; font-size:24rpx; }
.category-active { border-color:#20302a; color:#fff; background:#20302a; }
.dish-grid { display:grid; grid-template-columns:1fr 1fr; gap:24rpx; padding-bottom:36rpx; }
.dish-card { overflow:hidden; background:#fff; border:1rpx solid #e8ece8; border-radius:12rpx; box-shadow:0 8rpx 24rpx rgba(32,48,42,.04); }
.dish-image { display:block; width:100%; height:190rpx; background:#e7ebe4; }
.dish-info { padding:20rpx; }
.dish-name { color:#20302a; font-weight:700; font-size:30rpx; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; }
.dish-category { margin-top:8rpx; color:#9aa49d; font-size:21rpx; }
.dish-action { display:flex; justify-content:flex-end; align-items:center; margin-top:18rpx; min-height:56rpx; }
.add-button,.small-button { padding:0 20rpx; height:52rpx; line-height:52rpx; border:0; border-radius:26rpx; color:#fff; background:#20302a; font-size:22rpx; }
.stepper { display:flex; align-items:center; border:1rpx solid #dfe6df; border-radius:28rpx; height:52rpx; }
.step { display:flex; justify-content:center; align-items:center; width:52rpx; height:52rpx; color:#20302a; font-size:34rpx; line-height:1; }
.quantity { min-width:30rpx; text-align:center; color:#20302a; font-size:24rpx; }
.empty-state { display:flex; flex-direction:column; align-items:center; justify-content:center; gap:14rpx; padding:140rpx 0; color:#929e96; font-size:25rpx; }
.empty-icon { color:#c8d0c8; font-size:68rpx; line-height:1; }
.loading-dot { color:#d6a455; font-size:20rpx; }
.error-banner { margin-top:20rpx; padding:20rpx; color:#9c5d4b; background:#fff1eb; border-radius:10rpx; font-size:23rpx; }
.basket-bar { position:fixed; z-index:10; left:24rpx; right:24rpx; bottom:24rpx; display:flex; align-items:center; justify-content:space-between; padding:16rpx 16rpx 16rpx 20rpx; border:1rpx solid #e3e8e3; border-radius:16rpx; background:rgba(255,255,255,.96); box-shadow:0 10rpx 36rpx rgba(32,48,42,.14); }
.basket-summary { display:flex; align-items:center; flex:none; gap:16rpx; }
.basket-badge { display:flex; align-items:center; justify-content:center; width:54rpx; height:54rpx; border-radius:50%; color:#fff; background:#d6a455; font-weight:700; }
.basket-label { display:block; color:#78867d; font-size:21rpx; white-space:nowrap; }
.basket-total { display:block; margin-top:4rpx; color:#20302a; font-weight:700; font-size:24rpx; white-space:nowrap; }
.basket-button,.primary-button { height:76rpx; padding:0 30rpx; border:0; border-radius:10rpx; color:#fff; background:#20302a; font-size:26rpx; line-height:76rpx; }
.basket-button { flex:none; width:auto !important; margin:0 0 0 auto; }
.basket-button text { margin-left:14rpx; color:#e2b96f; font-size:34rpx; }
.section-heading { display:flex; align-items:center; justify-content:space-between; padding:38rpx 0 22rpx; }.section-title { display:block; color:#20302a; font-size:34rpx; font-weight:700; }.section-note { display:block; margin-top:8rpx; color:#9aa49d; font-size:22rpx; }.refresh { color:#b37e31; font-size:23rpx; }.back-menu { display:flex; align-items:center; gap:4rpx; padding:12rpx 18rpx 12rpx 12rpx; border:1rpx solid #e4e9e4; border-radius:999rpx; background:#f7f9f5; color:#536158; font-size:23rpx; font-weight:600; box-shadow:0 5rpx 12rpx rgba(32,48,42,.06); }.back-menu-icon { display:flex; align-items:center; justify-content:center; width:26rpx; height:30rpx; font-size:38rpx; font-family:Arial,sans-serif; font-weight:400; line-height:26rpx; transform:translateY(-1rpx); color:#2f9f6b; }
.order-date { display:flex; align-items:center; gap:8rpx; padding:28rpx 0 14rpx; color:#536158; font-size:24rpx; font-weight:600; }.date-clock { color:#2f9fdd; font-size:28rpx; }.order-card { margin-bottom:20rpx; padding:24rpx; border:1rpx solid #e6ebe6; border-radius:12rpx; background:#fff; }.order-top { display:flex; align-items:flex-start; justify-content:space-between; }.order-customer { color:#20302a; font-weight:700; font-size:29rpx; }.order-time { margin-left:16rpx; color:#a0aaa3; font-size:21rpx; }.order-items { margin-top:22rpx; color:#46564d; font-size:25rpx; line-height:1.6; }.order-remark { margin-top:14rpx; padding-top:14rpx; border-top:1rpx solid #eef1ed; color:#9aa49d; font-size:22rpx; }
.family-intro { display:flex; flex-direction:column; align-items:center; padding:100rpx 30rpx; text-align:center; }.family-icon { margin-bottom:30rpx; color:#d6a455; font-size:80rpx; }.family-intro .section-title { font-size:36rpx; }.family-intro .section-note { margin:16rpx 0 38rpx; }.primary-button { min-width:280rpx; }
.family-header { display:flex; align-items:flex-end; justify-content:space-between; padding:42rpx 0 14rpx; }.family-name { margin-top:12rpx; font-size:42rpx; }.family-id { color:#a2aba4; font-size:21rpx; }.member-list { border-top:1rpx solid #e6ebe6; }.member-row { display:flex; align-items:center; padding:22rpx 0; border-bottom:1rpx solid #e6ebe6; }.avatar { display:flex; align-items:center; justify-content:center; width:64rpx; height:64rpx; border-radius:50%; color:#fff; background:#758b7d; font-size:28rpx; }.member-main { flex:1; margin-left:18rpx; }.member-name { display:block; font-size:27rpx; font-weight:600; }.member-role { display:block; margin-top:5rpx; color:#a0aaa3; font-size:21rpx; }.member-remove { color:#b37e31; font-size:21rpx; }.member-input,.form-input,.form-textarea { flex:1; padding:0 20rpx; border:1rpx solid #dfe6df; border-radius:10rpx; background:#fff; font-size:25rpx; }.member-input { height:70rpx; }.small-button { height:70rpx; line-height:70rpx; }
.family-switcher { display:flex; align-items:center; gap:14rpx; padding-top:28rpx; overflow-x:auto; white-space:nowrap; }.switcher-label { color:#8b978f; font-size:23rpx; }.family-chip { padding:10rpx 20rpx; border:1rpx solid #dfe6df; border-radius:24rpx; color:#7d8a82; background:#fff; font-size:23rpx; }.family-chip-active { border-color:#20302a; color:#fff; background:#20302a; }.invite-panel,.join-panel { margin-top:30rpx; padding:24rpx; border:1rpx solid #e5ebe5; border-radius:14rpx; background:#fff; }.join-panel { margin-bottom:40rpx; }.invite-title { color:#536158; font-size:24rpx; font-weight:600; }.invite-code { margin-top:16rpx; color:#b37e31; font-size:44rpx; letter-spacing:8rpx; font-weight:700; }.invite-button { margin-top:16rpx; }.join-row { display:flex; align-items:center; gap:14rpx; width:100%; margin-top:16rpx; }.join-row .member-input { min-width:0; }.join-row .small-button { flex:none; width:180rpx; padding:0; }
.content { max-width:100%; overflow-x:hidden; }.profile-panel,.invite-panel,.join-panel { box-sizing:border-box; width:100%; max-width:100%; }.join-row .member-input { flex:1; width:0; box-sizing:border-box; }.join-row .small-button { flex:0 0 150rpx; width:150rpx; padding:0; box-sizing:border-box; }
.menu-content { display:flex; overflow:hidden; }.menu-layout { display:flex; width:100%; height:100%; min-height:0; }.menu-content .category-list { flex:0 0 142rpx; width:142rpx; height:100%; min-height:0; padding:18rpx 0 40rpx; overflow-y:auto; box-sizing:border-box; }.dish-scroll { flex:1; width:0; height:100%; min-width:0; }.dish-scroll .dish-panel { min-height:100%; box-sizing:border-box; }.basket-safe-space { height:150rpx; }
