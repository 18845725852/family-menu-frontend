/* Warm white / olive theme. Keep the shared browsing and management list. */
.family-loading, .family-load-error { min-height: 360rpx; padding: 32rpx 0; }
.family-skeleton-line { height: 56rpx; margin-bottom: 20rpx; border-radius: 10rpx; background: #f0f1eb; }
.family-skeleton-short { width: 62%; }
.family-loading-note, .family-load-error { color: #828579; font-size: 23rpx; line-height: 1.6; }
.family-load-error .me-secondary { margin-top: 24rpx; }
.page-shell { padding-bottom: calc(104rpx + env(safe-area-inset-bottom)); }
.page-shell > .hero { padding-right: 32rpx; padding-bottom: 24rpx; padding-left: 32rpx; }
.hero-main { padding: 12rpx 0; border: 0; border-radius: 0; background: transparent; box-shadow: none; }
.page-shell > .hero .hero-copy { margin-left: 0; }
.page-shell > .hero .hero-title { color: #30332b; font-family: "Songti SC", "STSong", "SimSun", serif; font-size: 40rpx; font-weight: 400; line-height: 1.4; letter-spacing: 1rpx; }
.page-shell > .hero .hero-subtitle { margin-top: 8rpx; padding: 0; border-radius: 0; background: transparent; color: #828579; font-size: 23rpx; font-weight: 400; line-height: 1.5; }
.menu-content .menu-search-row { height: 88rpx; padding: 8rpx 28rpx 16rpx; border: 0; background: #fafaf7; }
.menu-search-field { height: 64rpx; border: 0; border-radius: 12rpx; background: #f0f1eb; }
.menu-search-icon { width: 34rpx; height: 34rpx; margin-left: 18rpx; }
.menu-search-input { height: 64rpx; font-size: 25rpx; }
.search-placeholder { color: #8b8f81; }
.search-clear { color: #777d66; }
.menu-content .menu-layout { background: #fafaf7; }
.menu-content .category-list { flex: 0 0 138rpx; width: 138rpx; padding-top: 12rpx; background: #f5f5f0; }
.menu-content .category { display: flex; width: 100%; min-height: 100rpx; padding: 16rpx 14rpx; border: 0; border-radius: 0; background: transparent; color: #828579; font-size: 24rpx; font-weight: 400; }
.menu-content .category-active { background: #eceedf; color: #4f5743; font-weight: 600; }
.category-active::before { top: 30rpx; bottom: 30rpx; width: 4rpx; border-radius: 0; background: #777d66; }
.menu-content .dish-scroll, .menu-content .dish-panel { background: #fafaf7; }
.dish-panel { padding: 16rpx 24rpx 32rpx 20rpx; }
.dish-heading { margin-bottom: 4rpx; color: #30332b; font-size: 28rpx; font-weight: 500; line-height: 1.5; }
.dish-count { color: #8b8f81; font-size: 21rpx; }
.dish-section + .dish-section { margin-top: 22rpx; }
.dish-scroll .dish-card { padding: 22rpx 0; background: transparent; }
.dish-scroll .dish-image { width: 140rpx; height: 140rpx; border-radius: 12rpx; background: #f0f0eb; }
.dish-scroll .dish-info { padding: 0 12rpx 0 18rpx; }
.dish-name-row { min-width: 0; }
.dish-name { display: block; min-width: 0; color: #30332b; font-size: 29rpx; font-weight: 600; line-height: 1.4; }
.dish-description { margin-top: 7rpx; color: #828579; font-size: 22rpx; line-height: 1.5; }
.dish-recipe-link { margin-top: 10rpx; color: #777d66; font-size: 22rpx; font-weight: 400; }
.add-circle { width: 56rpx; height: 56rpx; background: #777d66; font-size: 36rpx; }
.dish-card .stepper { height: 56rpx; border-color: #e0e3d8; background: #f3f4ed; }
.dish-card .step { width: 48rpx; height: 56rpx; color: #575e4b; font-size: 30rpx; }
.dish-card .quantity { min-width: 24rpx; font-size: 24rpx; }
.bottom-nav { height: calc(104rpx + env(safe-area-inset-bottom)); border-top: 1rpx solid #e9eae3; background: #fff; }
.nav-item { gap: 6rpx; color: #8b8f81; }
.nav-icon { display: block; flex: none; width: 40rpx; height: 40rpx; }
.nav-item label { font-size: 21rpx; line-height: 1.3; }
.nav-active { color: #575e4b; font-weight: 600; }
.basket-bar, .batch-bar { z-index: 15; left: 20rpx; right: 20rpx; bottom: calc(116rpx + env(safe-area-inset-bottom)); border: 1rpx solid #e3e5dc; border-radius: 16rpx; background: #fff; box-shadow: 0 4rpx 18rpx rgba(63, 69, 54, .05); }
.basket-bar { gap: 24rpx; padding: 12rpx 14rpx 12rpx 24rpx; }
.basket-bar .basket-summary { flex: 1; align-items: flex-start; }
.basket-label { color: #828579; font-size: 22rpx; }
.basket-total { color: #30332b; font-size: 28rpx; font-weight: 500; }
.basket-bar .basket-button { flex: none; width: 180rpx !important; border-radius: 12rpx; font-weight: 500; }
.basket-safe-space, .edit-safe-space { height: 138rpx; }
.menu-custom-bar { margin: 0 24rpx 12rpx; padding: 12rpx 16rpx; border-color: #e3e5dc; background: #f4f5ef; }
.menu-custom-title { color: #4f5743; font-weight: 500; }
.menu-custom-note { color: #828579; font-size: 21rpx; }
.menu-edit-done { padding: 0 24rpx; background: #575e4b; font-weight: 500; }
.add-dish-btn { margin: 0 24rpx 12rpx; border: 1rpx solid #e3e5dc; background: #fafaf7; }
.add-dish-plus { background: #eff1e8; color: #777d66; }
.add-dish-title { color: #575e4b; font-weight: 500; }
.add-dish-arrow { color: #8b8f81; }
.dish-card-editing .dish-info { padding-left: 14rpx !important; }
.dish-card-editing .dish-check { width: 40rpx; height: 40rpx; border-color: #c2c7b6; }
.dish-card-editing .dish-check-on { border-color: #777d66; background: #777d66; }
.dish-card-editing.dish-card-selected { background: #eff1e8; }
.dish-card-editing .dish-name { color: #30332b; font-weight: 500; }
.dish-card-editing .dish-description, .dish-card-editing .dish-recipe-link { color: #828579; font-size: 21rpx; }
.dish-ops { gap: 22rpx; margin-top: 4rpx; }
.dish-edit, .dish-delete { padding: 10rpx 0; font-size: 23rpx; }
.dish-edit { color: #6f775e; }
.dish-delete { color: #a66f64; }
.batch-bar { height: 88rpx; }
.batch-all { color: #575e4b; font-size: 23rpx; }
.batch-count { color: #828579; font-size: 22rpx; }
.batch-delete { height: 60rpx; background: #a66f64; font-size: 23rpx; line-height: 60rpx; }
.batch-delete-disabled { background: #dfd1cb; color: #fff; }
.overlay { z-index: 30; background: rgba(48, 51, 43, .35); }
.sheet { padding-bottom: calc(32rpx + env(safe-area-inset-bottom)); border-radius: 20rpx 20rpx 0 0; background: #fafaf7; }
.sheet-title, .dish-detail-name { color: #30332b; font-weight: 500; }
.sheet-clear, .editor-upload { color: #777d66; }
.form-input, .form-textarea { border-color: #e3e5dc; border-radius: 12rpx; background: #fff; color: #30332b; }
.primary-button, .dish-detail-action { border-radius: 12rpx; background: #3f4536; font-weight: 500; }
.editor-sheet { padding-bottom: calc(24rpx + env(safe-area-inset-bottom)); }
.editor-scroll { flex: 1; height: 0; min-height: 0; }
.editor-footer { margin-top: 16rpx; }
.empty-photo { border: 1rpx dashed #d4d8c9; border-radius: 16rpx; background: #f4f5ef; box-shadow: none; }
.empty-photo-art { display: none; }
.empty-photo-title { color: #575e4b; font-size: 27rpx; font-weight: 400; }
.empty-photo-hint { color: #828579; }
.me-card { border-color: #e9eae3; border-radius: 16rpx; box-shadow: none; }
.me-name, .me-card-title, .me-menu-title, .section-title, .order-customer { color: #30332b; font-weight: 500; }
.me-edit, .family-manage { background: #eff1e8; color: #6f775e; font-weight: 400; }
.me-primary, .me-secondary, .me-join { border-radius: 12rpx; font-weight: 500; }
.family-page .family-chip-active { border-color: #777d66; background: #777d66; }
.back-menu { border-radius: 12rpx; background: #f4f5ef; box-shadow: none; }
.order-card { border-color: #e9eae3; }
.logout-btn { border-radius: 16rpx; background: #faf6f3; font-weight: 400; box-shadow: none; }
.login-card { border: 1rpx solid #e3e5dc; border-radius: 20rpx; background: #fafaf7; box-shadow: none; }
.login-logo { border-radius: 16rpx; background: #eff1e8; color: #777d66; font-weight: 400; box-shadow: none; }
.login-title { color: #30332b; font-weight: 500; }
.login-button { border-radius: 12rpx; background: #3f4536; font-weight: 500; box-shadow: none; }
@media (max-width: 360px) {
  .menu-content .category-list { flex-basis: 116rpx; width: 116rpx; }
  .dish-panel { padding-right: 16rpx; padding-left: 16rpx; }
  .dish-scroll .dish-image { width: 120rpx; height: 120rpx; }
  .dish-card .step { width: 42rpx; }
}
