.profile-panel { margin-top:28rpx; padding:24rpx; border:1rpx solid #e5ebe5; border-radius:14rpx; background:#fff; }.profile-tip { margin-top:12rpx; color:#a0aaa3; font-size:21rpx; }
.family-owner-tip { margin-top:18rpx; padding:16rpx 18rpx; border-radius:12rpx; background:#f3f6f2; color:#7b8981; font-size:22rpx; }
.account-panel { margin:24rpx 0 48rpx; }.logout-button { width:100%; height:70rpx; margin:0; padding:0 28rpx; border:1rpx solid #e8c9c1; border-radius:16rpx; background:#fff8f6; color:#b25f50; font-size:24rpx; line-height:68rpx; box-sizing:border-box; }
.basket-bar { z-index:20; left:204rpx; right:20rpx; bottom:calc(96rpx + env(safe-area-inset-bottom)); }
