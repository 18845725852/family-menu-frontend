.wheel-banner { display:flex; align-items:center; justify-content:space-between; gap:18rpx; margin:20rpx 20rpx 0; padding:22rpx 22rpx; border:1rpx solid #e6dfd1; border-radius:18rpx; background:linear-gradient(135deg,#fff9ef,#fff); box-shadow:0 10rpx 30rpx rgba(214,164,85,.14); }
