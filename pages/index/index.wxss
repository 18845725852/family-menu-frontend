.page-shell {
  height: 100vh;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  box-sizing: border-box;
  padding-bottom: 128rpx;
  background-color: #fafaf7;
  background-image: none;
  background-repeat: no-repeat;
  background-size: 100% auto;
  background-position: center top;
}
.page-shell > .hero {
  display: block;
  flex: none;
  padding-right: 24rpx;
  padding-bottom: 16rpx;
  padding-left: 24rpx;
  border-bottom: 0;
  background: transparent;
}
.hero-main {
  display: flex;
  align-items: center;
  padding: 20rpx 22rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.92);
  border-radius: 28rpx;
  background: rgba(255, 255, 255, 0.82);
  box-shadow: 0 12rpx 28rpx rgba(176, 92, 62, 0.08);
}
.page-shell > .hero .hero-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 26rpx;
  background: linear-gradient(145deg, #ff8368 0%, #e44b40 100%);
  box-shadow: 0 10rpx 20rpx rgba(228, 75, 64, 0.26), inset 0 2rpx 0 rgba(255, 255, 255, 0.35);
  font-size: 40rpx;
  font-weight: 800;
}
.page-shell > .hero .hero-copy {
  flex: 1;
  min-width: 0;
  margin-left: 20rpx;
}
.page-shell > .hero .hero-title {
  margin-top: 0;
  color: #2a211c;
  font-size: 36rpx;
  line-height: 1.2;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}
.page-shell > .hero .hero-subtitle {
  display: inline-block;
  margin-top: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  background: #fff1e8;
  color: #c56a45;
  font-size: 20rpx;
  font-weight: 600;
}
.page-shell > .content {
  flex: 1;
  min-height: 0;
  width: 100% !important;
  height: auto !important;
  margin: 0 !important;
}
.page-shell > .content.tab-hidden,
.menu-content.tab-hidden {
  display: none !important;
  height: 0 !important;
  min-height: 0 !important;
  overflow: hidden !important;
  pointer-events: none;
}
.page-shell > .content:not(.menu-content) {
  padding-left: 32rpx;
  padding-right: 32rpx;
  box-sizing: border-box;
}
.page-shell > .content.wheel-content { display:flex; flex-direction:column; padding:0; overflow:hidden; }
.wheel-panel { display:block; flex:1; width:100%; height:0; min-height:0; }
.page-shell > .content.menu-content {
  flex: 1 1 0;
  height: 0 !important;
  min-height: 0;
}
.menu-content {
  display: flex !important;
  flex-direction: column;
  overflow: hidden;
}
.menu-content .menu-search-row {
  flex: none;
}
.menu-content .menu-layout {
  flex: 1 1 0;
  min-height: 0;
  height: 0 !important;
  background: #fff;
}
.menu-content .category-list {
  background: #f4f6f5;
}
.menu-content .dish-scroll,
.menu-content .dish-panel {
  background: #fff;
}

.basket-bar {
  display: flex;
