<wxs module="fmt">
module.exports.initial = function (name) {
  name = name || ''
  return name.length ? name.substring(0, 1) : '饭'
}
</wxs>
<view class="page-shell">
  <view class="hero" style="padding-top: {{headerTop}}px;">
    <view class="hero-main">
      <view class="hero-avatar">饭</view>
      <view class="hero-copy">
        <view class="hero-title">干饭人！干饭魂！</view>
        <view class="hero-subtitle">干饭都是人上人！</view>
      </view>
    </view>
  </view>

  <view class="content menu-content {{activeTab === 'menu' ? '' : 'tab-hidden'}}">
    <view class="wheel-banner" bindtap="goWheel"><view><text class="wheel-banner-title">今晚吃什么</text><text class="wheel-banner-subtitle">把转盘交给概率，省掉来回纠结</text></view><view class="wheel-banner-action">去转盘</view></view>
    <view class="menu-search-row"><view class="menu-search-field"><image class="menu-search-icon" src="/assets/search.svg" mode="aspectFit"/><input class="menu-search-input" placeholder="" value="{{searchKeyword}}" bindinput="inputSearch" confirm-type="search"/><text class="search-clear" style="margin-right:22rpx" wx:if="{{searchKeyword}}" bindtap="clearSearch">清空</text></view></view>
    <view wx:if="{{loggedIn && familyId && customMenu}}" class="menu-custom-bar">
      <view class="menu-custom-copy">
        <text class="menu-custom-title">编辑模式</text>
        <text class="menu-custom-note">{{editMode ? '可以添加、修改和删除菜品' : '关闭后按正常点菜使用'}}</text>
      </view>
      <switch checked="{{editMode}}" color="#20302a" bindchange="toggleEditMode"/>
    </view>
    <view wx:if="{{customMenu && editMode}}" class="menu-custom-add" bindtap="openDishEditor">添加菜品</view>
    <view class="menu-layout">
      <view class="category-list">
        <view wx:for="{{categories}}" wx:key="id" class="category {{activeCategory === item.name ? 'category-active' : ''}}" data-id="{{item.id}}" data-category="{{item.name}}" catchtap="selectCategory"><view class="category-label"><view>{{item.line1}}</view><view wx:if="{{item.line2}}">{{item.line2}}</view></view></view>
      </view>
      <scroll-view class="dish-scroll" scroll-y scroll-into-view="{{scrollIntoView}}" scroll-with-animation="{{scrollAnimated}}" bindscroll="onDishScroll" refresher-enabled="true" bindrefresherrefresh="onPullDownRefresh">
        <view wx:if="{{error}}" class="error-banner">{{error}}</view>
        <view class="dish-panel">
        <view wx:if="{{loading}}" class="empty-state"><text class="loading-dot">●</text><text>正在准备今日菜单</text></view>
        <view wx:elif="{{!displayDishes.length}}" class="empty-state"><text class="empty-icon">⌂</text><text>还没有可供应的菜品</text></view>
        <block wx:else>
          <view wx:for="{{dishSections}}" wx:for-item="section" wx:key="id" id="dish-section-{{section.id}}" class="dish-section">
          <view class="dish-heading"><text>{{section.name}}</text><text class="dish-count">{{section.dishes.length}} 道</text></view>
          <block wx:for="{{section.dishes}}" wx:for-item="item" wx:key="id">
          <view class="dish-card" style="display:flex;align-items:center;min-height:150rpx;margin:0;padding:14rpx 0;border:0;border-bottom:1rpx solid #f0f2f0;box-shadow:none">
            <image class="dish-image" style="flex:none;width:142rpx;height:142rpx;border-radius:20rpx" src="{{item.imageUrl || defaultDishUrl}}" mode="aspectFill" lazy-load="true" fade-show="true" data-image="{{item.imageUrl || defaultDishUrl}}" catchtap="previewDishImage"></image>
            <view class="dish-info" style="flex:1;min-width:0;padding:0 14rpx" data-id="{{item.id}}" catchtap="openDishDetail"><view class="dish-name-row"><text class="dish-name">{{item.name}}</text><view wx:if="{{customMenu && editMode}}" class="dish-ops"><text class="dish-edit" data-id="{{item.id}}" catchtap="openDishEditor">编辑</text><text class="dish-delete" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="deleteDishFromList">删除</text></view></view><view class="dish-category dish-description">{{item.description}}</view><view class="dish-recipe-link">{{item.recipeSteps.length ? '查看做法 >>' : '查看介绍 >>'}}</view></view>
            <view class="dish-action" style="flex:none;margin:0;min-height:0"><view wx:if="{{item.quantity}}" class="stepper"><text class="step" data-id="{{item.id}}" catchtap="decreaseDish">−</text><text class="quantity">{{item.quantity}}</text><text class="step" data-id="{{item.id}}" catchtap="increaseDish">＋</text></view><view wx:else class="add-circle" data-id="{{item.id}}" catchtap="addDish">＋</view></view>
          </view>
          </block>
          </view>
        </block>
        <view wx:if="{{basketCount}}" class="basket-safe-space"></view>
        </view>
      </scroll-view>
    </view>
  </view>

  <scroll-view class="content order-content {{activeTab === 'orders' ? '' : 'tab-hidden'}}" scroll-y>
    <view class="section-heading"><view><text class="section-title">最近的点菜</text><text class="section-note">共 {{orders.length}} 单</text></view><view class="back-menu" data-tab="menu" bindtap="switchTab"><text class="back-menu-icon">‹</text><text>返回菜谱</text></view></view>
    <view wx:if="{{!loggedIn}}" class="empty-state">
      <text class="empty-icon">◷</text>
      <text>登录之后才能看到订单列表</text>
      <text class="empty-login-link" bindtap="goLogin">去登录</text>
    </view>
    <view wx:elif="{{!orders.length}}" class="empty-state"><text class="empty-icon">◷</text><text>还没有订单，先去选几道菜吧</text></view>
    <block wx:for="{{orders}}" wx:key="id">
      <view wx:if="{{item.showDate}}" class="order-date"><text class="date-clock">◷</text><text>{{item.dateLabel}}</text></view>
      <view class="order-card"><view class="order-top"><image class="order-avatar" src="{{item.customerAvatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image><view class="order-main"><text class="order-customer">{{item.customerName}}</text><text class="order-time">{{item.displayClock}}</text></view></view>
      <view class="order-items"><view wx:for="{{item.items}}" wx:for-item="orderItem" wx:key="dishId" class="order-item-row" style="display:flex;align-items:center;justify-content:space-between;min-height:64rpx;padding:8rpx 0;border-bottom:1rpx solid #f0f2f0"><text class="order-item-name" style="flex:1">{{orderItem.dishName}}</text><text class="order-item-quantity" style="margin-left:16rpx;color:#7f8a82">× {{orderItem.quantity}}</text></view></view>
      <view wx:if="{{item.remark}}" class="order-remark">备注：{{item.remark}}</view>
      </view>
    </block>
  </scroll-view>

  <scroll-view class="content family-page {{activeTab === 'family' ? '' : 'tab-hidden'}}" scroll-y>
    <view wx:if="{{!loggedIn}}" class="guest-home">
      <image class="guest-avatar" src="/assets/default-avatar.jpg" mode="aspectFill"></image>
      <view class="guest-title">未登录</view>
      <view class="guest-subtitle">登录后可以管理家庭组、查看订单，并用你的称呼点菜</view>
      <view wx:if="{{loginError}}" class="login-error">{{loginError}}</view>
      <button class="login-button guest-login" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="beginLogin">{{loginLoading ? '正在登录…' : '微信登录'}}</button>
      <view class="login-tip">仅使用微信身份识别你的家庭组和点菜记录</view>
    </view>
    <block wx:else>
      <view class="me-card me-profile">
        <view class="me-avatar-wrap">
          <button class="me-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar" hover-class="none">
            <image class="me-avatar-image" src="{{profileAvatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
          </button>
          <view class="me-avatar-badge">换</view>
        </view>
        <view class="me-copy">
          <view wx:if="{{!profileEditing}}" class="me-name-row">
            <text class="me-name">{{profileName || '未设置称呼'}}</text>
            <text class="me-edit" bindtap="editProfile">编辑</text>
          </view>
          <view wx:else class="profile-edit-row">
            <input class="member-input" type="nickname" placeholder="例如：张三、李四" value="{{profileName}}" data-field="profileName" bindinput="input" maxlength="50"/>
            <button class="small-button profile-save" loading="{{profileSaving}}" bindtap="saveProfile">保存</button>
            <text class="profile-cancel" bindtap="cancelProfileEdit">取消</text>
          </view>
          <view class="me-tip">点击头像更换微信头像</view>
        </view>
      </view>

      <view wx:if="{{!family}}" class="me-card me-empty">
        <view class="me-empty-title">还没有家庭组</view>
        <view class="me-empty-note">创建后，家人称呼会自动出现在点菜记录里</view>
        <view class="me-primary" bindtap="openFamily">创建家庭组</view>
      </view>
      <view wx:else class="me-card">
        <view class="me-card-head">
          <text class="me-card-title">我的家庭组</text>
          <text class="me-card-note">{{members.length}} 位成员</text>
        </view>
        <view class="family-switcher">
          <view wx:for="{{families}}" wx:key="id" class="family-chip {{familyId === item.id ? 'family-chip-active' : ''}}" data-id="{{item.id}}" bindtap="switchFamily">{{item.name}}</view>
        </view>
        <view class="me-menu-row">
          <view class="me-menu-copy">
            <text class="me-menu-title">使用家庭组菜谱</text>
            <text class="me-menu-note">{{customMenu ? '当前家庭组使用自己的菜谱' : '关闭时看到的为默认菜谱'}}</text>
          </view>
          <switch checked="{{customMenu}}" color="#20302a" bindchange="toggleCustomMenu"/>
        </view>
        <view class="member-list">
          <view wx:for="{{members}}" wx:key="id" class="member-row">
            <image class="avatar avatar-image" src="{{item.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
            <view class="member-main">
              <text class="member-name">{{item.nickname}}</text>
              <text class="member-role">{{item.role === 'OWNER' ? '家庭组创建者' : '家庭成员'}}</text>
            </view>
            <text wx:if="{{item.role !== 'OWNER'}}" class="member-remove" data-id="{{item.id}}" bindtap="removeMember">移除</text>
          </view>
        </view>
        <view class="invite-block">
          <view class="me-subtitle">邀请家人加入</view>
          <view wx:if="{{inviteCode}}" class="invite-code">{{inviteCode}}</view>
          <view class="me-secondary" bindtap="createInviteCode">{{inviteCode ? '重新生成邀请码' : '生成邀请码'}}</view>
        </view>
      </view>

      <view class="me-card">
        <view class="me-card-title">加入其他家庭组</view>
        <view class="join-row">
          <input class="member-input" placeholder="输入 6 位邀请码" value="{{joinCode}}" data-field="joinCode" bindinput="input" maxlength="6"/>
          <view class="me-join {{joinLooking ? 'me-join-disabled' : ''}}" bindtap="previewJoinFamily">{{joinLooking ? '查询中' : '查询'}}</view>
        </view>
        <view wx:if="{{joinPreview}}" class="join-preview">
          <view class="join-preview-label">即将加入</view>
          <view class="join-preview-name">{{joinPreview.familyName}}</view>
          <view class="join-preview-actions">
            <view class="me-secondary join-cancel" bindtap="clearJoinPreview">取消</view>
            <view class="me-join" bindtap="joinFamily">确认加入</view>
          </view>
        </view>
      </view>
      <view class="logout-btn" bindtap="logout">退出登录</view>
    </block>
  </scroll-view>
</view>

<view class="bottom-nav"><view class="nav-item {{activeTab === 'menu' ? 'nav-active' : ''}}" data-tab="menu" catchtap="switchTab"><text>▦</text><label>菜谱</label></view><view class="nav-item {{activeTab === 'orders' ? 'nav-active' : ''}}" data-tab="orders" catchtap="switchTab"><text>▤</text><label>订单</label></view><view class="nav-item {{activeTab === 'family' ? 'nav-active' : ''}}" data-tab="family" catchtap="switchTab"><text>♧</text><label>我的</label></view></view>

<view wx:if="{{activeTab === 'menu' && basketCount}}" class="basket-bar"><view class="basket-summary" bindtap="openBasket"><text class="basket-label">已选菜品</text><text class="basket-total">{{basketTotal}} 份</text></view><view class="basket-button" bindtap="openOrder">去下单</view></view>

<view wx:if="{{basketVisible}}" class="overlay" style="position:fixed;top:0;right:0;bottom:0;left:0;height:100vh;display:flex;align-items:flex-end" bindtap="closeBasket"><view class="sheet basket-sheet" catchtap="noop"><view class="sheet-head"><text class="sheet-title">已选菜单</text><text class="sheet-clear" bindtap="clearBasket">清空</text></view><scroll-view class="basket-scroll" scroll-y><view wx:for="{{basket}}" wx:for-item="basketItem" wx:key="dishId" class="basket-row"><image class="basket-item-image" style="flex:none;width:72rpx;height:72rpx;margin-right:16rpx;border-radius:12rpx" src="{{basketItem.imageUrl || defaultDishUrl}}" mode="aspectFill"></image><view class="basket-dish">{{basketItem.dishName}}</view><view class="stepper"><text class="step" data-id="{{basketItem.dishId}}" bindtap="decreaseDish">−</text><text class="quantity">{{basketItem.quantity}}</text><text class="step" data-id="{{basketItem.dishId}}" bindtap="increaseDish">＋</text></view></view></scroll-view><button class="primary-button sheet-button" bindtap="closeBasket">确认菜单</button></view></view>

<view wx:if="{{orderVisible}}" class="overlay"><view class="sheet order-sheet"><view class="sheet-head"><text class="sheet-title">提交这桌菜</text><text class="sheet-close" bindtap="closeOrder">×</text></view><view class="form-label">开饭备注 <text class="optional">选填</text></view><textarea class="form-textarea" placeholder="例如：六点开饭、少油少盐" value="{{orderRemark}}" data-field="orderRemark" bindinput="input" maxlength="200"></textarea><view class="confirm-total">共 {{basketCount}} 种菜</view><button class="primary-button sheet-button" loading="{{submitting}}" bindtap="submitOrder">提交订单</button></view></view>

<view wx:if="{{familyVisible}}" class="overlay"><view class="sheet"><view class="sheet-head"><text class="sheet-title">创建家庭组</text><text class="sheet-close" bindtap="closeFamily">×</text></view><view class="form-label">家庭组名称</view><input class="form-input" placeholder="例如：我们家" value="{{familyName}}" data-field="familyName" bindinput="input" maxlength="30"/><view class="family-owner-tip">创建者将使用当前称呼：{{profileName}}</view><button class="primary-button sheet-button" bindtap="createFamily">创建并进入</button></view></view>

<view wx:if="{{previewImageVisible}}" class="image-preview-mask" bindtap="closePreviewImage"><view class="image-preview-card" catchtap="noop"><text class="image-preview-close" bindtap="closePreviewImage">×</text><image class="image-preview" src="{{previewImageUrl}}" mode="widthFix"></image></view></view>

<view wx:if="{{dishDetailVisible}}" class="overlay" bindtap="closeDishDetail">
  <view class="sheet dish-detail-sheet" catchtap="noop">
    <text class="sheet-close dish-detail-close" bindtap="closeDishDetail">×</text>
    <image class="dish-detail-image" src="{{dishDetail.imageUrl || defaultDishUrl}}" mode="aspectFill"></image>
    <view class="dish-detail-body">
      <view class="dish-detail-name">{{dishDetail.name}}</view>
      <view wx:if="{{dishDetail.description}}" class="dish-detail-desc">{{dishDetail.description}}</view>
      <view class="dish-detail-section">制作方法</view>
      <view wx:if="{{!dishDetail.recipeSteps.length}}" class="dish-detail-empty">这道菜还没有写做法</view>
      <view wx:for="{{dishDetail.recipeSteps}}" wx:for-index="stepIndex" wx:key="*this" class="recipe-step">
        <text class="recipe-text">{{item}}</text>
      </view>
    </view>
    <view class="dish-detail-action" data-id="{{dishDetail.id}}" bindtap="addDishFromDetail">加入菜单</view>
  </view>
</view>


<view wx:if="{{dishEditorVisible}}" class="overlay" bindtap="closeDishEditor">
  <view class="sheet editor-sheet" catchtap="noop">
    <view class="sheet-head"><text class="sheet-title">{{editorDishId ? '编辑菜品' : '添加菜品'}}</text><text class="sheet-close" bindtap="closeDishEditor">×</text></view>
    <scroll-view class="editor-scroll" scroll-y>
      <view class="form-label">菜名</view>
      <input class="form-input" value="{{editorName}}" data-field="editorName" bindinput="input" maxlength="50"/>
      <view class="form-label">分类</view>
      <picker mode="selector" range="{{categories}}" range-key="name" bindchange="chooseEditorCategory">
        <view class="form-input editor-picker">{{editorCategory || '请选择已有分类'}}</view>
      </picker>
      <view class="form-label">描述 <text class="optional">选填</text></view>
      <input class="form-input" value="{{editorDescription}}" data-field="editorDescription" bindinput="input" maxlength="200"/>
      <view class="form-label">做法 <text class="optional">选填，一行一步</text></view>
      <textarea class="form-textarea" value="{{editorRecipe}}" data-field="editorRecipe" bindinput="input" maxlength="4000"></textarea>
      <view class="form-label">顺序</view>
      <input class="form-input" type="number" value="{{editorSort}}" data-field="editorSort" bindinput="input"/>
    </scroll-view>
    <view class="editor-image-row">
      <image class="editor-image" src="{{editorImagePreview || defaultDishUrl}}" mode="aspectFill"></image>
      <view class="editor-upload" bindtap="chooseEditorImage">上传图片</view>
    </view>
    <view class="editor-footer">
      <button wx:if="{{editorDishId}}" class="editor-delete-btn" bindtap="deleteDishEditor">删除</button>
      <button class="primary-button editor-save" loading="{{editorSaving}}" bindtap="saveDishEditor">保存</button>
    </view>
  </view>
</view>

<view wx:if="{{loginVisible}}" class="login-gate">
  <view class="login-card">
    <view class="login-logo">饭</view>
    <view class="login-title">欢迎来点菜</view>
    <view class="login-subtitle">{{loginPurpose}}</view>
    <view wx:if="{{loginError}}" class="login-error">{{loginError}}</view>
    <button class="login-button" loading="{{loginLoading}}" disabled="{{loginLoading}}" bindtap="beginLogin">{{loginLoading ? '正在登录…' : '微信登录并进入'}}</button>
    <view class="login-skip" bindtap="closeLogin">继续逛逛</view>
    <view class="login-tip">仅使用微信身份识别你的家庭和点菜记录</view>
  </view>
</view>
