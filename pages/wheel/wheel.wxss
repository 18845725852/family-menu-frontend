.page { position: relative; z-index: 1; min-height: 100vh; padding: 200rpx 28rpx 48rpx; box-sizing: border-box; background-color: #d8ebf2; background-image: url('/assets/page-bg.png'); background-repeat: no-repeat; background-size: 100% auto; background-position: center top; }
.topbar { position:relative; display:flex; align-items:flex-start; justify-content:space-between; gap:16rpx; margin-bottom:28rpx; padding-bottom:72rpx; }
.eyebrow { display:block; color:#8a988f; font-size:20rpx; letter-spacing:3rpx; font-weight:600; }
.title { margin-top:10rpx; color:#20302a; font-size:46rpx; font-weight:800; line-height:1.15; }
.subtitle { margin-top:10rpx; color:#5f6f66; font-size:24rpx; line-height:1.45; }
.back-btn { position:absolute; right:0; bottom:0; display:flex; align-items:center; gap:6rpx; padding:12rpx 20rpx 12rpx 14rpx; border:1rpx solid rgba(32,48,42,.1); border-radius:999rpx; background:linear-gradient(135deg,#20302a 0%,#3c5148 100%); color:#fff; font-size:23rpx; font-weight:700; box-shadow:0 8rpx 18rpx rgba(32,48,42,.16); }
.back-icon { display:flex; align-items:center; justify-content:center; width:28rpx; height:32rpx; font-size:42rpx; font-family:Arial,sans-serif; font-weight:400; line-height:28rpx; transform:translateY(-1rpx); }
.stage { display:flex; flex-direction:column; align-items:center; }
.wheel-frame { position:relative; width:560rpx; height:560rpx; margin:22rpx auto 28rpx; }
.wheel-spin { position:relative; width:100%; height:100%; border-radius:50%; border:14rpx solid #fff; box-shadow:0 20rpx 54rpx rgba(32,48,42,.16); overflow:hidden; background:#fff; box-sizing:border-box; }
.wheel-image { position:absolute; top:0; left:0; z-index:1; width:100%; height:100%; display:block; border-radius:50%; }
.wheel-label-layer { position:absolute; top:0; right:0; bottom:0; left:0; z-index:5; pointer-events:none; }
.wheel-center { position:absolute; z-index:6; left:50%; top:50%; width:88rpx; height:88rpx; margin:-44rpx 0 0 -44rpx; border-radius:50%; background:rgba(255,255,255,.92); box-shadow:0 4rpx 12rpx rgba(32,48,42,.15), inset 0 0 0 5rpx rgba(255,255,255,.8); display:flex; align-items:center; justify-content:center; }
.wheel-label { position:absolute; transform:translate(-50%, -50%); color:#263630; font-family:-apple-system-font,BlinkMacSystemFont,"Helvetica Neue",sans-serif; font-weight:600; line-height:1.22; text-align:center; word-break:keep-all; text-shadow:0 1rpx 2rpx rgba(255,255,255,.65); }
.wheel-label-line { display:block; white-space:nowrap; }
.wheel-pointer { position:absolute; z-index:5; left:50%; top:50%; width:138rpx; height:30rpx; margin-top:-15rpx; transform:rotate(-90deg); transform-origin:0 50%; backface-visibility:hidden; pointer-events:none; }
.pointer-shaft { position:absolute; left:10rpx; top:6rpx; width:96rpx; height:18rpx; border-radius:18rpx; background:linear-gradient(90deg,#f1785d 0%,#d83f4b 100%); box-shadow:0 4rpx 9rpx rgba(160,40,40,.3), inset 0 2rpx 2rpx rgba(255,255,255,.4); }
.pointer-head { position:absolute; right:0; top:0; width:0; height:0; border-top:15rpx solid transparent; border-bottom:15rpx solid transparent; border-left:28rpx solid #d83f4b; }
.spin-button { width:60rpx; height:60rpx; border-radius:50%; display:flex; align-items:center; justify-content:center; text-align:center; padding:0; box-sizing:border-box; background:linear-gradient(135deg,#20302a 0%,#3c5148 100%); color:#fff; font-size:28rpx; font-weight:800; letter-spacing:2rpx; text-indent:2rpx; box-shadow:0 8rpx 18rpx rgba(32,48,42,.24); }
.spin-button.disabled { opacity:.78; }
.result-card { width:100%; padding:22rpx 24rpx; border-radius:18rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(32,48,42,.08); box-sizing:border-box; }
.result-label { color:#8a988f; font-size:22rpx; }
.result-name { margin-top:8rpx; color:#20302a; font-size:36rpx; font-weight:800; }
.result-pending { margin-top:8rpx; color:#9aa49d; font-size:30rpx; font-weight:600; }
.status-text { margin-top:18rpx; color:#8a988f; font-size:23rpx; }
.status-text.error { color:#c9685e; }
.panel { margin-top:24rpx; padding:22rpx; border-radius:18rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(32,48,42,.08); }
.panel-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:14rpx; }
.panel-title { color:#20302a; font-size:30rpx; font-weight:700; }
.panel-note { color:#a0aaa3; font-size:22rpx; }
.chip-wrap { display:flex; flex-wrap:wrap; gap:12rpx; }
.chip { padding:10rpx 16rpx; border-radius:999rpx; background:#f4f6f2; color:#536158; font-size:23rpx; }
