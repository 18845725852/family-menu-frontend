<view class="order-page">
  <view class="order-header"><view class="order-heading"><text class="back-button" bindtap="goBack">‹</text><view><text class="title">确认这桌菜</text><text class="subtitle">下单前再核对一下</text></view></view></view>
  <view class="user-card"><view class="avatar">{{operatorInitial}}</view><view><text class="user-label">当前登录人</text><text class="user-name">{{operatorName}}</text></view></view>
  <view class="field-label member-label">点菜成员</view>
  <picker wx:if="{{memberNames.length}}" mode="selector" range="{{memberNames}}" value="{{memberIndex}}" bindchange="selectMember"><view class="member-picker"><text>{{customerName}}</text><text class="picker-arrow">⌄</text></view></picker>
  <view wx:else class="member-picker member-picker-disabled"><text>{{operatorName}}</text></view>
  <view class="section-title">已选菜品 <text>{{basketCount}} 份</text></view>
  <view class="dish-list"><view wx:for="{{basket}}" wx:key="dishId" class="dish-row"><view class="dish-name">{{item.dishName}}</view><view class="quantity"><text data-id="{{item.dishId}}" data-delta="-1" bindtap="changeQuantity">−</text><text>{{item.quantity}}</text><text data-id="{{item.dishId}}" data-delta="1" bindtap="changeQuantity">＋</text></view></view></view>
  <view class="field-label">开饭备注 <text>选填</text></view>
  <textarea class="remark" maxlength="200" placeholder="例如：六点开饭、少油少盐、不要香菜" value="{{remark}}" bindinput="inputRemark"></textarea>
  <button class="submit" loading="{{submitting}}" bindtap="submitOrder">提交订单</button>
</view>
