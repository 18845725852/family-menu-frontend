:host { display:block; margin-bottom:20rpx; }
.swipe-row { position:relative; overflow:hidden; border-radius:12rpx; background:#a66f64; }
.swipe-content { position:relative; z-index:1; transition:transform .18s ease-out; }
.without-transition { transition:none; }
.delete-button { position:absolute; top:0; right:0; bottom:0; display:flex; align-items:center; justify-content:center; width:144rpx; color:#fff; font-size:26rpx; font-weight:600; }
.delete-disabled { opacity:.6; }
