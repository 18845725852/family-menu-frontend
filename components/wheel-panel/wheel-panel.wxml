<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" bounces="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view class="draw-screen" style="height: {{drawScreenHeight}}px;">
  <view class="topbar">
    <view>
      <view class="title">外出吃什么</view>
      <view class="subtitle">{{hasFamily ? '家庭抽卡，选项和结果全家人都能看到' : (loggedIn ? '加入家庭后，抽卡和结果才会全家共享' : '别纠结了，让命运替你点单')}}</view>
    </view>
    <view class="back-btn" bindtap="goBack"><text class="back-icon">‹</text><text>返回菜谱</text></view>
  </view>

  <view class="stage">
    <view class="card-stage {{spinning ? 'card-stage-busy' : ''}}" bindtap="spinWheel" role="button" aria-label="抽取一张餐厅卡">
      <view class="card-canvas" style="transform: scale({{cardScale}});">
      <view class="card-pack" id="card-pack" style="{{workletEnabled ? '' : 'transform: ' + packTransform + '; transition: transform ' + cardDuration + 'ms ease-in-out;'}}">
        <view class="card-deck" id="card-deck" style="{{workletEnabled ? '' : 'transform: ' + deckTransform + '; transition: transform ' + cardDuration + 'ms ease-in-out;'}}">
          <view class="deck-card deck-card-third"><view class="card-inner-border"></view></view>
          <view class="deck-card deck-card-second"><view class="card-inner-border"></view></view>
        </view>
        <view class="draw-card" id="draw-card" style="{{workletEnabled ? '' : 'transform: ' + cardTransform + '; transition: transform ' + cardDuration + 'ms ease-in-out;'}}">
          <view id="card-back-face" class="card-back" aria-hidden="{{cardFaceFront}}" style="{{workletEnabled ? '' : 'opacity: ' + (cardFaceFront ? 0 : 1) + ';'}}">
            <view class="card-inner-border"></view>
            <text class="card-star card-star-top">✧</text>
            <view class="card-back-copy">
              <text class="card-back-eyebrow">FAMILY TABLE</text>
              <view class="card-back-title">今晚<text class="card-back-title-line">有约</text></view>
              <text class="card-back-note">一张卡，决定这一餐</text>
            </view>
            <text class="card-star card-star-bottom">✧</text>
          </view>
          <view id="card-front-face" class="card-front" aria-hidden="{{!cardFaceFront}}" style="{{workletEnabled ? '' : 'opacity: ' + (cardFaceFront ? 1 : 0) + ';'}}">
            <view class="card-front-top"><text>今日 · 餐厅推荐</text><text>✧</text></view>
            <image class="card-illustration" src="/assets/dining-card.svg" mode="aspectFit" fade-show="{{false}}" lazy-load="{{false}}"></image>
            <view class="card-result-copy">
              <text class="card-result-label">这一餐，就去</text>
              <view class="card-result-name">{{cardRestaurantName}}</view>
            </view>
            <view class="card-front-footer"><text>和家人，好好吃饭。</text><text>↗</text></view>
          </view>
        </view>
      </view>
      </view>
    </view>
    <view class="deck-caption">{{restaurants.length ? '共 ' + restaurants.length + ' 张餐厅卡 · 每次随机抽取' : '把想去的餐厅，放进这一叠卡'}}</view>
    <button class="draw-button {{loading || error || editing || saving || spinning || recording || !restaurants.length ? 'draw-button-disabled' : ''}}" disabled="{{loading || error || editing || saving || spinning || recording || !restaurants.length}}" bindtap="spinWheel">{{loading ? '正在准备卡牌…' : (spinning ? (drawPhase === 'shuffling' || drawPhase === 'preparing' || drawPhase === 'gathering' ? '正在洗牌…' : (drawPhase === 'drawing' || drawPhase === 'holding' ? '正在抽出…' : '正在揭晓…')) : (recording ? '正在保存记录…' : (hasSpun ? '再抽一张' : '抽一张，去吃饭')))}}</button>
    <view class="draw-hint">{{spinning ? '让这一餐，多一点期待' : '也可以轻点卡牌开始抽取'}}</view>
    <view wx:if="{{error}}" class="status-text error">{{error}}<text class="retry-link" bindtap="loadWheel">重新加载</text></view>
  </view>

  </view>

  <view wx:if="{{hasFamily}}" class="panel">
    <view class="panel-head">
      <view>
        <view class="panel-title">家庭抽卡记录</view>
        <view class="panel-note">最近 5 次</view>
      </view>
      <view wx:if="{{spins.length}}" class="panel-link" bindtap="openHistory">查看所有记录</view>
    </view>
    <view wx:if="{{recentSpins.length}}" class="spin-list">
      <view wx:for="{{recentSpins}}" wx:key="id" class="spin-row">
        <image class="spin-avatar" src="{{item.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
        <view class="spin-main">
          <view class="spin-line">
            <text class="spin-user">{{item.nickname}}</text>
            <text class="spin-action">抽到</text>
            <text class="spin-restaurant">{{item.restaurantName}}</text>
          </view>
          <view class="spin-time">{{item.timeText}}</view>
        </view>
      </view>
    </view>
    <view wx:else class="panel-login-tip">还没有记录。抽一张，家里人都能看到。</view>
  </view>

  <view class="panel">
    <view class="panel-head">
      <view>
        <view class="panel-title">{{hasFamily ? '家庭餐厅' : '可选餐厅'}}</view>
        <view wx:if="{{editing}}" class="panel-note">{{draft.length}} / 16 家，至少 3 家</view>
        <view wx:elif="{{hasFamily && customized}}" class="panel-note">全家共用，改完其他人也能看到</view>
        <view wx:elif="{{hasFamily}}" class="panel-note">当前是默认餐厅，保存后变成家庭抽卡</view>
        <view wx:else class="panel-note">{{restaurants.length}} 家</view>
      </view>
      <view wx:if="{{hasFamily && !editing}}" class="panel-edit {{loading || error || spinning || recording ? 'disabled' : ''}}" bindtap="startEdit">编辑</view>
      <view wx:elif="{{hasFamily && editing}}" class="panel-actions">
        <view class="panel-cancel {{saving ? 'disabled' : ''}}" bindtap="cancelEdit">取消</view>
        <view class="panel-save {{saving ? 'disabled' : ''}}" bindtap="saveDraft">{{saving ? '保存中' : '保存'}}</view>
      </view>
    </view>
    <view wx:if="{{!editing}}" class="chip-wrap">
      <view wx:for="{{restaurants}}" wx:for-item="item" wx:key="id" class="chip">{{item.name}}</view>
    </view>
    <view wx:else class="editor">
      <view wx:for="{{draft}}" wx:for-item="item" wx:key="key" class="editor-row">
        <input class="editor-input" value="{{item.name}}" disabled="{{saving}}" data-index="{{index}}" maxlength="20" placeholder="餐厅名称" bindinput="inputDraft"/>
        <view class="editor-remove {{saving ? 'disabled' : ''}}" data-index="{{index}}" bindtap="removeDraft">删除</view>
      </view>
      <view class="editor-add {{saving || draft.length >= 16 ? 'disabled' : ''}}" bindtap="addDraft">{{draft.length >= 16 ? '已到上限 16 家' : '+ 添加餐厅'}}</view>
    </view>
    <view wx:if="{{!loggedIn}}" class="panel-login-tip">
      登录并加入家庭后，可以自定义家庭抽卡
      <text class="panel-login-link" bindtap="goLogin">去登录</text>
    </view>
    <view wx:elif="{{loggedIn && !hasFamily}}" class="panel-login-tip">
      先创建或加入家庭组，抽卡才会全家共享
      <text class="panel-login-link" bindtap="goFamily">去我的家庭</text>
    </view>
  </view>
</view>
</scroll-view>

<view wx:if="{{historyVisible}}" class="history-mask" bindtap="closeHistory">
  <view class="history-card" catchtap="noop">
    <view class="history-head">
      <view>
        <view class="panel-title">全部抽卡记录</view>
        <view class="panel-note">{{historyLoading ? '正在读取' : '共 '}}{{historyLoading ? '' : allSpins.length}}{{historyLoading ? '' : ' 条'}}</view>
      </view>
      <view class="history-close" bindtap="closeHistory">关闭</view>
    </view>
    <scroll-view class="history-scroll" scroll-y show-scrollbar="{{false}}" style="height: {{historyHeight}}px;">
      <view wx:if="{{historyLoading && !allSpins.length}}" class="panel-login-tip">正在读取全部记录…</view>
      <view wx:elif="{{!allSpins.length}}" class="panel-login-tip">还没有记录</view>
      <view wx:else class="spin-list">
        <view wx:for="{{allSpins}}" wx:key="id" class="spin-row">
          <image class="spin-avatar" src="{{item.avatarUrl || defaultAvatarUrl}}" mode="aspectFill"></image>
          <view class="spin-main">
            <view class="spin-line">
              <text class="spin-user">{{item.nickname}}</text>
              <text class="spin-action">抽到</text>
              <text class="spin-restaurant">{{item.restaurantName}}</text>
            </view>
            <view class="spin-time">{{item.timeText}}</view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</view>
