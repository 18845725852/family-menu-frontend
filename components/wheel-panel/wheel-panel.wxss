:host { display:block; height:100%; min-height:0; }
view, text { box-sizing:border-box; }
.page-scroll { width:100%; height:100%; min-height:0; box-sizing:border-box; background:transparent; }
.page { position: relative; z-index: 1; height: auto; min-height: auto; padding: 0 28rpx 40rpx; box-sizing: border-box; background: transparent; }
.draw-screen { display:flex; flex-direction:column; padding-bottom:12rpx; box-sizing:border-box; }
.topbar { position:relative; display:flex; flex:none; align-items:flex-start; gap:16rpx; margin-bottom:8rpx; padding-bottom:0; }
.topbar > view:first-child { flex:1; min-width:0; }
.eyebrow { display:block; color:#8a988f; font-size:20rpx; letter-spacing:3rpx; font-weight:600; }
.title { margin-top:10rpx; color:#3f4536; font-size:46rpx; font-weight:800; line-height:1.15; }
.subtitle { margin-top:8rpx; color:#5f6f66; font-size:22rpx; line-height:1.45; }
.back-btn { display:flex; flex:none; margin-top:10rpx; align-items:center; gap:6rpx; padding:10rpx 16rpx; border:1rpx solid #e3e5dc; color:#575e4b; font-size:23rpx; }
.back-icon { display:flex; align-items:center; justify-content:center; width:28rpx; height:32rpx; font-size:42rpx; font-family:Arial,sans-serif; font-weight:400; line-height:28rpx; transform:translateY(-1rpx); }
.stage { display:flex; flex:1; min-height:0; flex-direction:column; align-items:center; }
.card-stage { position:relative; flex:1; min-height:0; width:100%; }
.card-canvas { position:absolute; top:0; left:50%; width:694rpx; height:800rpx; margin-left:-347rpx; transform-origin:50% 0; }
.deck-card, .draw-card { position:absolute; left:50%; top:144rpx; width:380rpx; height:480rpx; margin-left:-190rpx; border:1rpx solid #d2d7c5; border-radius:22rpx; background:#eceedf; }
.card-pack, .card-deck { position:absolute; top:0; right:0; bottom:0; left:0; transform-origin:50% 384rpx; }
.deck-card { background-image:url('/assets/card-weave.svg'); background-repeat:repeat; background-size:40rpx 40rpx; }
.deck-card-third { transform:translate(18rpx, -8rpx) rotate(7deg); background:#e7eada; }
.deck-card-second { transform:translate(-14rpx, -4rpx) rotate(-5deg); background:#f0f1e7; }
.draw-card { z-index:2; box-shadow:0 12rpx 32rpx rgba(63,69,54,.08); }
.card-back, .card-front { position:absolute; top:0; left:0; display:flex; flex-direction:column; width:100%; height:100%; border-radius:22rpx; overflow:hidden; pointer-events:none; }
.card-back { align-items:center; justify-content:center; background-color:#eceedf; background-image:url('/assets/card-weave.svg'); background-repeat:repeat; background-size:40rpx 40rpx; }
.card-inner-border { position:absolute; top:14rpx; right:14rpx; bottom:14rpx; left:14rpx; border:1rpx solid #bbc2ac; border-radius:14rpx; }
.card-star { position:absolute; color:#8f987c; font-size:34rpx; line-height:1; }
.card-star-top { top:30rpx; left:30rpx; }
.card-star-bottom { bottom:30rpx; right:30rpx; }
.card-back-copy { display:flex; flex-direction:column; align-items:center; }
.card-back-eyebrow { color:#889174; font-size:17rpx; letter-spacing:4rpx; }
.card-back-title { margin-top:24rpx; color:#7c8668; font-family:"Songti SC", "STSong", "SimSun", serif; font-size:64rpx; line-height:1.1; letter-spacing:8rpx; text-align:center; }
.card-back-title-line { display:block; }
.card-back-note { margin-top:28rpx; color:#8b947d; font-size:20rpx; letter-spacing:2rpx; }
.card-front { padding:26rpx; background:#fffef9; opacity:0; }
.card-front-top { display:flex; justify-content:space-between; align-items:center; color:#828975; font-size:20rpx; letter-spacing:2rpx; }
.card-illustration { display:block; flex:1; min-height:0; width:100%; height:220rpx; margin:16rpx 0; }
.card-result-copy { flex:none; padding-bottom:20rpx; }
.card-result-label { color:#8b917f; font-size:21rpx; }
.card-result-name { margin-top:10rpx; color:#3f4536; font-family:"Songti SC", "STSong", "SimSun", serif; font-size:44rpx; line-height:1.25; word-break:break-all; }
.card-front-footer { display:flex; flex:none; justify-content:space-between; align-items:center; padding-top:18rpx; border-top:1rpx solid #e5e8da; color:#7c856c; font-size:20rpx; }
.deck-caption { flex:none; margin:0 0 12rpx; line-height:1.5; color:#8b917f; font-size:22rpx; letter-spacing:1rpx; text-align:center; }
.draw-button { flex:none; width:424rpx; height:72rpx; margin:0; padding:0 24rpx; border:0; border-radius:12rpx; background:#575e4b; color:#fff; font-size:27rpx; font-weight:400; line-height:72rpx; }
.draw-button::after { border:0; }
.draw-button-disabled { background:#e7eadf; color:#858e77; }
.draw-hint { flex:none; margin-top:12rpx; line-height:1.5; color:#959b8c; font-size:21rpx; }
.retry-link { margin-left:16rpx; color:#575e4b; text-decoration:underline; }
.status-text { margin-top:18rpx; color:#8a988f; font-size:23rpx; }
.status-text.error { color:#c9685e; }
.panel { margin-top:24rpx; padding:22rpx; border-radius:18rpx; background:#fff; box-shadow:0 12rpx 30rpx rgba(32,48,42,.08); }
.panel-head { display:flex; align-items:center; justify-content:space-between; margin-bottom:14rpx; }
.panel-title { color:#3f4536; font-size:30rpx; font-weight:700; }
.panel-note { color:#8b8f81; font-size:22rpx; }
.chip-wrap { display:flex; flex-wrap:wrap; gap:12rpx; }
.chip { padding:10rpx 16rpx; border-radius:999rpx; background:#f4f6f2; color:#536158; font-size:23rpx; }

.panel-edit,
.panel-save,
.panel-cancel {
  padding: 10rpx 18rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}
.panel-edit,
.panel-save {
  background: #3f4536;
  color: #fff;
}
.panel-actions {
  display: flex;
  align-items: center;
  gap: 10rpx;
}
.panel-cancel {
  background: #f4f6f2;
  color: #536158;
}
.panel-save.disabled,
.panel-edit.disabled,
.panel-cancel.disabled,
.editor-remove.disabled,
.editor-add.disabled {
  opacity: .55;
}
.panel-login-tip {
  margin-top: 16rpx;
  color: #8a988f;
  font-size: 22rpx;
  line-height: 1.5;
}
.editor-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}
.editor-input {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 20rpx;
  border-radius: 16rpx;
  background: #f4f5ef;
  color: #3f4536;
  font-size: 26rpx;
  box-sizing: border-box;
}
.editor-remove {
  flex: none;
  padding: 12rpx 8rpx;
  color: #a66f64;
  font-size: 23rpx;
  font-weight: 600;
}
.editor-add {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 72rpx;
  margin-top: 8rpx;
  border: 1rpx dashed #cfd8d2;
  border-radius: 16rpx;
  color: #3f4536;
  font-size: 25rpx;
  font-weight: 700;
  background: #fbfcf9;
}

.panel-login-link {
  margin-left: 8rpx;
  color: #777d66;
  font-size: 24rpx;
  font-weight: 700;
}

.spin-list { display:flex; flex-direction:column; }
.spin-row { display:flex; align-items:center; gap:16rpx; padding:16rpx 0; border-bottom:1rpx solid #f0f3ef; }
.spin-row:last-child { border-bottom:none; padding-bottom:0; }
.spin-avatar { width:64rpx; height:64rpx; border-radius:50%; background:#f4f6f2; flex:none; }
.spin-main { flex:1; min-width:0; }
.spin-line { display:flex; align-items:baseline; min-width:0; }
.spin-user { max-width:180rpx; color:#3f4536; font-size:26rpx; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.spin-action { flex:none; margin:0 8rpx; color:#8a988f; font-size:22rpx; }
.spin-restaurant { flex:1; min-width:0; color:#3f4536; font-size:26rpx; font-weight:700; overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
.spin-time { margin-top:4rpx; color:#8b8f81; font-size:22rpx; }

.panel-link { flex: none; color: #777d66; font-size: 24rpx; font-weight: 700; }
.history-mask { position: fixed; left: 0; right: 0; top: 0; bottom: 0; z-index: 40; background: rgba(32,48,42,.45); display: flex; align-items: flex-end; justify-content: center; }
.history-card { width: 100%; background: #fff; border-radius: 28rpx 28rpx 0 0; padding: 28rpx 28rpx calc(24rpx + env(safe-area-inset-bottom)); box-sizing: border-box; }
.history-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 12rpx; }
.history-close { padding: 10rpx 18rpx; border-radius: 999rpx; background: #f4f6f2; color: #536158; font-size: 23rpx; font-weight: 700; }

/* Match the shared warm white and olive theme. */
.title { color: #30332b; font-size: 40rpx; font-weight: 500; }
.panel { border: 1rpx solid #e9eae3; border-radius: 16rpx; box-shadow: none; }
.panel-title { font-weight: 500; }
.back-btn { border-radius: 12rpx; background: #f4f5ef; color: #575e4b; box-shadow: none; font-weight: 400; }
.panel-edit, .panel-save, .panel-cancel { border-radius: 12rpx; font-weight: 500; }
